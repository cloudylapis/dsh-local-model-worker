{
  "name": "dsh-local-model-worker",
  "version": "0.4.0",
  "description": "Run a local OpenAI-compatible model server on demand: pick a built-in backend, and DSH starts it when the model is used and unloads it when idle.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets/icon.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "local-llm",
    "local-model",
    "llm-server",
    "ollama",
    "lm-studio",
    "llama.cpp",
    "openai-compatible"
  ],
  "license": "MIT",
  "author": {
    "name": "cloudylapis",
    "url": "https://github.com/cloudylapis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudylapis/dsh-local-model-worker.git"
  },
  "homepage": "https://github.com/cloudylapis/dsh-local-model-worker#readme",
  "bugs": {
    "url": "https://github.com/cloudylapis/dsh-local-model-worker/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1 || >=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  }
}
